# Runtime
PORT=8080
APP_ENV=development

# GitHub
# Required for stable API responses; without token GitHub rate limits quickly.
GITHUB_TOKEN=
GITHUB_USERNAME=voyvodka

# Cache / Sync
# development: 1800 (30m), production target: 86400 (24h)
CACHE_TTL_SECONDS=1800
REFRESH_LOCK_SECONDS=30

# Internal endpoint protection
INTERNAL_REFRESH_API_KEY=

# CORS
ALLOWED_ORIGIN=http://localhost:5173

# SQLite path (mounted volume in production)
SQLITE_PATH=/app/data/portfolio.db
