{
  "name": "portfolio-frontend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "build": "tsc -b && pnpm run build:client && pnpm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.2.1",
    "isomorphic-dompurify": "^3.13.0",
    "marked": "^18.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "satori": "^0.26.0",
    "tsx": "^4.22.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}